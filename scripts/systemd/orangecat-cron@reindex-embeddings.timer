# SSOT: repo scripts/systemd/ — installed by deploy-selfhost.sh.
# Instance of the generic orangecat-cron@.service template (curls
# /api/cron/reindex-embeddings with CRON_SECRET). The safety net for search-index
# freshness: the per-row DB triggers POST to a hardcoded public URL and fail
# silently, so without this a write can vanish from search with nothing to repair it.
[Unit]
Description=OrangeCat search index reconcile (03:30 UTC)

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
