{
  "name": "orangecat",
  "version": "0.1.2",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "d": "./scripts/dev/dev-start.js"
  },
  "scripts": {
    "d": "node scripts/dev/dev-start.js",
    "dev": "next dev",
    "dev:clean": "bash scripts/dev.sh",
    "dev:nuke": "bash scripts/dev/nuke-cache.sh",
    "dev:win": "scripts/dev.bat",
    "kill:node": "powershell \"Stop-Process -Name node -Force -ErrorAction SilentlyContinue\"",
    "clear:cache": "rm -rf .next && npm cache clean --force",
    "fresh:start": "npm run kill:node && npm run clear:cache && npm run dev",
    "dev:port": "next dev -p 3020",
    "kill-ports": "powershell \"Get-Process node -ErrorAction SilentlyContinue | Stop-Process -Force\"",
    "build": "next build",
    "build:production": "NODE_ENV=production next build && npm run analyze",
    "build:analyze": "ANALYZE=true npm run build",
    "analyze": "node scripts/analysis/analyze-bundle.js",
    "start": "next start",
    "lint": "eslint src",
    "lint:check": "next lint",
    "lint:umlauts": "grep -rn --include='*.ts' --include='*.tsx' -E '(fuer|koennen|moeglich|muessen|wuerde|aehnlich|aerger|aendern|oeffnen|ueber|ueberall|zurueck|natuerlich|genuegt|Strasse|Gruesse)' src/ || echo 'No umlaut violations found'",
    "type-check": "tsc --noEmit --skipLibCheck --incremental false",
    "check:sizes": "node scripts/check-file-sizes.js",
    "check:duplication": "node scripts/check-duplication.mjs",
    "check:dead-fields": "node scripts/check-dead-fields.mjs",
    "check:dead-labels": "node scripts/check-dead-labels.mjs",
    "check:schema-columns": "node scripts/check-schema-columns.mjs",
    "check:currency-units": "node scripts/check-currency-units.mjs",
    "check:rpc-exists": "node scripts/check-rpc-exists.mjs",
    "check:one-current-user": "node scripts/check-one-current-user.mjs",
    "check:app-locale": "node scripts/check-app-locale.mjs",
    "check:type-scale": "node scripts/check-type-scale.mjs",
    "check:client-ip": "node scripts/check-client-ip.mjs",
    "check:user-scoped-deletes": "node scripts/check-user-scoped-deletes.mjs",
    "check:ai-models": "node scripts/check-ai-models.mjs",
    "check:mdx": "node scripts/check-mdx.mjs",
    "verify": "npm run ci:docs && npm run check:accent-ink && npm run type-check && npm run type-check:scripts && npm run check:sizes && npm run audit:routes && npm run lint && npm run check:duplication && npm run check:dead-fields && npm run check:dead-labels && npm run check:migration-versions && npm run check:schema-columns && npm run check:currency-units && npm run check:rpc-exists && npm run check:one-current-user && npm run check:app-locale && npm run check:type-scale && npm run check:client-ip && npm run check:user-scoped-deletes && npm run check:mdx && npm run test:unit",
    "audit:schema": "node scripts/db/audit-schema-drift.mjs",
    "audit:routes": "node scripts/audit-routes.mjs",
    "gen:types": "bash scripts/db/gen-types.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "test:security": "vitest run security ssrf crypto signing idempotency --passWithNoTests",
    "test:unit": "vitest run __tests__/unit __tests__/smoke __tests__/create tests/unit tests/env.test.ts",
    "test:auth": "vitest run auth",
    "test:integration": "vitest run __tests__/integration --passWithNoTests",
    "test:performance": "vitest run performance --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:smoke:auth": "vitest run __tests__/smoke/auth-login.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:brave": "playwright test --project=brave",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:node": "node tests/e2e/test-app.mjs",
    "test:e2e:full": "node tests/e2e/test-full-flow.mjs",
    "test:e2e:profile": "node tests/e2e/test-profile-save.mjs",
    "test:e2e:profile-edit": "node tests/e2e/test-profile-edit.mjs",
    "test:e2e:simple": "node tests/e2e/test-app-simple.mjs",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e:node && npm run test:e2e",
    "create-entity": "node scripts/cli/create-entity.js",
    "deploy:verify": "node scripts/deployment/browser-verify.js",
    "env:validate": "node scripts/validate-env.js",
    "postinstall": "npm install --include=optional sharp || echo 'Sharp optional install failed'",
    "precommit": "npm run lint:check && npm run type-check && npm run audit:routes && npm run test:unit && npm run test:e2e:node",
    "prepare": "husky || true",
    "health:check": "curl -f $PRODUCTION_URL/api/health || echo 'Health check failed'",
    "monitor:metrics": "node scripts/monitor-metrics.js",
    "optimize:images": "node scripts/optimize-images.js",
    "security:scan": "npm audit && npm run test:security",
    "performance:check": "node scripts/performance-check.js",
    "ts:report": "node scripts/report-ts-errors.js",
    "ci:quality": "npm run ts:report && npm run bundle:monitor || true",
    "mcp:server": "node mcp-server.js",
    "mcp:start": "concurrently \"npm run dev\" \"node scripts/mcp-server.js\" --names \"NEXT,MCP\" --prefix-colors \"cyan,magenta\"",
    "mcp:test": "concurrently \"npm run mcp:server\" \"npm run test:e2e:ui\"",
    "mcp:fs": "node mcp-servers/fs-server.js",
    "mcp:shell": "node mcp-servers/shell-server.js",
    "mcp:git": "node mcp-servers/git-server.js",
    "mcp:lint": "node mcp-servers/lint-server.js",
    "mcp:orchestrate": "node scripts/mcp-orchestrate.mjs",
    "browser": "node scripts/browser-automation.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check-links": "node scripts/check-documentation-links.js",
    "docs:check-links:ci": "node scripts/check-documentation-links.js --ci",
    "docs:slop-scan": "node scripts/docs-slop-scan.js",
    "docs:frontmatter:check": "node scripts/docs-frontmatter-check.js",
    "ci:docs": "npm run docs:slop-scan && npm run docs:frontmatter:check",
    "design:check": "node scripts/design-system-check.js",
    "check:accent-ink": "node scripts/check-accent-ink.mjs",
    "bundle:analyze": "ANALYZE=true npm run build",
    "bundle:monitor": "node scripts/bundle-size-monitor.js",
    "bundle:check": "npm run build && npm run bundle:monitor",
    "lint:long": "node scripts/check-file-sizes.js",
    "cleanup:repo": "node scripts/cleanup-repo.js",
    "test:smoke": "BASE_URL=http://localhost:3000 playwright test tests/e2e/smoke.spec.ts --reporter=list",
    "test:e2e:matrix": "playwright test tests/e2e/workflow-matrix.spec.ts --project=chromium --reporter=line",
    "test:e2e:matrix:p0": "playwright test tests/e2e/workflow-matrix.spec.ts --project=chromium --grep @p0 --reporter=line",
    "db:audit": "node scripts/db-audit.mjs",
    "eval:voice": "node scripts/eval-voice-routing.mjs",
    "check:migration-versions": "node scripts/check-migration-versions.mjs",
    "type-check:scripts": "tsc --noEmit --skipLibCheck -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^2.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@marsidev/react-turnstile": "^1.6.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@next/mdx": "^16.1.6",
    "@noble/hashes": "^2.3.0",
    "@noble/secp256k1": "^2.3.0",
    "@octokit/rest": "^22.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@scure/base": "^2.2.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.108.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/dompurify": "^3.2.0",
    "@types/lodash": "^4.17.25",
    "@types/mdx": "^2.0.13",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.38.2",
    "ai-kit": "github:bitbaum/ai-kit#v0.6.2",
    "autoprefixer": "^10.5.4",
    "bech32": "^2.0.0",
    "bip32": "^5.0.0",
    "bitcoinjs-lib": "^6.1.0",
    "bs58check": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "critters": "^0.0.23",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.13",
    "dotenv": "^17.4.2",
    "focus-trap-react": "^11.0.4",
    "framer-motion": "^13.1.1",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.27",
    "jose": "^6.2.3",
    "lodash": "^4.17.23",
    "lucide-react": "^1.33.0",
    "next": "^16.2.12",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "nostr-tools": "^2.23.3",
    "postcss": "^8.5.10",
    "qrcode": "^1.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-focus-lock": "^2.13.7",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^9.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tiny-secp256k1": "^2.2.4",
    "typescript": "^5.8.3",
    "uuid": "^14.0.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.2",
    "@playwright/mcp": "^0.0.79",
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.16.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "chalk": "^6.0.0",
    "concurrently": "^10.0.4",
    "dotenv": "^16.5.0",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jscpd": "5.0.16",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "shadcn": "^4.19.0",
    "supabase": "^2.115.0",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "sharp": "^0.35.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@isaacs/brace-expansion": "^5.0.1",
    "sharp": "$sharp",
    "@babel/core": "^7.29.6",
    "hono": "^4.12.27",
    "js-yaml": "^4.1.1",
    "gray-matter": {
      "js-yaml": "^3.14.1"
    },
    "tar": "^7.5.8",
    "postcss": "^8.5.10",
    "uuid": "^14.0.0",
    "shell-quote": "^1.8.4"
  }
}
